# ==============================================================================
# Git Ignore: Runtime & Generated Artifacts
# ==============================================================================

# Credentials & environment
.env
*.env
*.pem
*.key
id_rsa
id_rsa.pub

# Generated Runtime Files (created during terraform apply)
**/ansible/inventory.ini
automated-web-server-monitoring/id_rsa
evidence/
**/evidence/*

# Terraform runtime & state
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Ansible runtime
*.retry
.ansible/

# OS / Editor temporary files
.DS_Store
Thumbs.db
.vscode/
.idea/
